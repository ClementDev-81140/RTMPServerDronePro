<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destination Settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#18181B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#2D2D35"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Channel Name"
                    android:textColor="#A0A0A8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/editTextChannelName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#25252B"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#606068"
                    android:hint="e.g. Telegram Live, YouTube"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RTMP / RTMPS URL"
                    android:textColor="#A0A0A8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/editTextRtmpUrl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#25252B"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#606068"
                    android:hint="rtmps://dc4-1.rtmp.t.me/s/"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stream Key"
                    android:textColor="#A0A0A8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/editTextStreamKey"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#25252B"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#606068"
                    android:hint="e.g. 123456789:ABCdef..."
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <!-- Option Chaîne Principale / Prioritaire -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chaîne Principale (Prioritaire ⭐)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Destination prioritaire en cas de basculement"
                            android:textColor="#A0A0A8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchIsPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quality &amp; Target Bitrate"
                    android:textColor="#A0A0A8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/radioGroupQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioLow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="720p • 1.0 Mbps (Faible bande passante)"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#6C5CE7" />

                    <RadioButton
                        android:id="@+id/radioMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="1080p • 2.5 Mbps (Recommandé)"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#6C5CE7" />

                    <RadioButton
                        android:id="@+id/radioHigh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1080p • 4.0 Mbps (Haute qualité)"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#6C5CE7" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonCancelChannel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2D2D35" />

            <Button
                android:id="@+id/buttonSaveChannel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Save"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#6C5CE7" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
